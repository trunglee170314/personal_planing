NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_MODE=cloud
# Enable only AFTER applying 0021/0022 and provisioning the confirmed administrator.
NEXT_PUBLIC_ACCESS_APPROVALS_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_PUSH_WORKER_URL=https://myplan-push.trungvanle.workers.dev

# Local/offline mode only. Leave empty to use the documented default paths.
MYPLAN_LOCAL_DB_PATH=
# Absolute path as seen by Node; in WSL use /mnt/c/Users/YOUR_USER/myplan-backups.
# Must be outside the source checkout. Do not point the live DB at a cloud-sync folder.
MYPLAN_BACKUP_DIR=
